rules_version = '2';

// Who can read and change accounts and companies. These are the real guard: the app follows the same rules, but
// anything it skips is refused here. See src/lib/accounts.ts for the sign-up flow they protect.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function verified() { return request.auth.token.email_verified == true; }
    function emailDomain() { return request.auth.token.email.lower().split('@')[1]; }
    function userDoc(id) { return get(/databases/$(database)/documents/users/$(id)); }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid())) && userDoc(uid()).data.role == 'admin';
    }
    function ownsCompany(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == uid();
    }
    function companyAfter(companyId) { return getAfter(/databases/$(database)/documents/companies/$(companyId)).data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Someone let into a company (its owner or an approved colleague), who can post its jobs and tests
    function worksAt(companyId) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.get('companyId', null) == companyId && userDoc(uid()).data.status == 'active'
        && userDoc(uid()).data.role == 'recruiter';
    }
    function activeCandidate() {
      return signedIn() && verified() && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.role == 'candidate';
    }
    function jobDoc(jobId) { return get(/databases/$(database)/documents/jobs/$(jobId)).data; }
    // Keep in step with src/lib/emailDomains.ts
    function freeDomains() {
      return ['gmail.com', 'googlemail.com', 'outlook.com', 'hotmail.com', 'hotmail.co.uk', 'live.com', 'live.co.uk',
        'msn.com', 'yahoo.com', 'yahoo.co.uk', 'ymail.com', 'icloud.com', 'me.com', 'mac.com', 'aol.com', 'proton.me',
        'protonmail.com', 'gmx.com', 'gmx.co.uk', 'mail.com', 'zoho.com', 'yandex.com', 'btinternet.com', 'sky.com',
        'virginmedia.com', 'talktalk.net', 'qq.com', '163.com'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        uid() == userId || isAdmin() ||
        (resource.data.get('companyId', null) != null && ownsCompany(resource.data.companyId))
      );

      // A new account is a candidate (active) or a company sign-up (setup); nobody makes themselves an admin
      allow create: if signedIn() && uid() == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'status', 'companySetup', 'createdAt'])
        && ((request.resource.data.role == 'candidate' && request.resource.data.status == 'active')
          || (request.resource.data.role == 'recruiter' && request.resource.data.status == 'setup'));

      allow update: if signedIn() && (
        isAdmin()
        // Your own name
        || (uid() == userId && changed().hasOnly(['name']))
        // Finishing a company sign-up, once the email is verified
        || (uid() == userId && resource.data.status == 'setup' && verified() && changed().hasOnly(['status', 'companyId']) && (
          // Created the company for your domain and run it
          (request.resource.data.status == 'active' && request.resource.data.companyId == emailDomain()
            && companyAfter(emailDomain()).ownerUid == uid())
          // Asked to join your domain's company
          || (request.resource.data.status == 'pending-approval' && request.resource.data.companyId == emailDomain()
            && exists(/databases/$(database)/documents/companies/$(emailDomain()))
            && getAfter(/databases/$(database)/documents/companies/$(emailDomain())/members/$(uid())).data.status == 'pending-approval')
          // No work email: waiting for the Vetter team
          || (request.resource.data.status == 'pending-review' && request.resource.data.companyId == 'review-' + uid()
            && companyAfter('review-' + uid()).ownerUid == uid())
        ))
        // A company owner approving or turning down a colleague
        || (resource.data.status == 'pending-approval' && changed().hasOnly(['status'])
          && request.resource.data.status in ['active', 'rejected'] && ownsCompany(resource.data.companyId))
      );
      allow delete: if isAdmin();
    }

    // A candidate's public profile and results (what leaderboards and companies see), written only by them once
    // their email is verified. Never their email or where they applied
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && uid() == userId && verified()
        && userDoc(userId).data.role == 'candidate'
        && request.resource.data.id == userId && request.resource.data.role == 'candidate'
        && !request.resource.data.keys().hasAny(['email', 'appliedJobIds', 'applicationProfiles']);
      allow delete: if isAdmin();
    }

    // Jobs are public. A company posts and edits its own; the Vetter team any. Applying adds one to the count
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAdmin() || worksAt(request.resource.data.businessId);
      allow update: if isAdmin()
        || (worksAt(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId)
        || (changed().hasOnly(['applicantCount']) && request.resource.data.applicantCount == resource.data.applicantCount + 1
          && !exists(/databases/$(database)/documents/applications/$(jobId + '__' + uid()))
          && existsAfter(/databases/$(database)/documents/applications/$(jobId + '__' + uid())));
      allow delete: if isAdmin() || worksAt(resource.data.businessId);

      // Who the job's tests went to. The company sends them; a candidate puts themselves on the job by opening its
      // link (or an emailed invitation) and records when they opened it and started
      match /invitations/{candidateId} {
        function candidateOwnFields() {
          return request.resource.data.keys().hasOnly(['candidateId', 'invitedAt', 'via', 'openedAt', 'startedAt', 'attempts', 'jobId', 'businessId']);
        }
        // Tries at the job's tests only ever grow: a candidate can't wipe a start they left unsubmitted
        function attemptsKept() {
          return !('attempts' in resource.data)
            || (request.resource.data.get('attempts', []) is list && request.resource.data.get('attempts', []).size() >= resource.data.attempts.size());
        }
        function sameJob() {
          return request.resource.data.jobId == jobId && request.resource.data.businessId == jobDoc(jobId).get('businessId', '');
        }
        allow create: if sameJob() && request.resource.data.candidateId == candidateId && (
          isAdmin() || worksAt(jobDoc(jobId).get('businessId', ''))
          || (uid() == candidateId && activeCandidate() && candidateOwnFields() && (
            request.resource.data.via == 'link'
            || (request.resource.data.via == 'email'
              && exists(/databases/$(database)/documents/jobs/$(jobId)/emailInvites/$(request.auth.token.email.lower())))
          ))
        );
        allow update: if (isAdmin() || worksAt(resource.data.businessId))
          || (uid() == candidateId && changed().hasOnly(['openedAt', 'startedAt', 'attempts']) && attemptsKept());
        allow delete: if isAdmin() || worksAt(resource.data.businessId);
      }

      // Addresses the job's tests were emailed to; the person at one can see theirs once they sign in
      match /emailInvites/{email} {
        allow create, update, delete: if isAdmin() || worksAt(jobDoc(jobId).get('businessId', ''));
      }
    }

    // Read rules for both, also when queried across every job
    match /{path=**}/invitations/{candidateId} {
      allow read: if signedIn() && (uid() == resource.data.candidateId || isAdmin() || worksAt(resource.data.businessId));
    }
    match /{path=**}/emailInvites/{email} {
      allow read: if signedIn() && (isAdmin() || worksAt(resource.data.businessId)
        || (verified() && resource.data.email == request.auth.token.email.lower()));
    }

    // Where a candidate is in a company's hiring for one job (stage, rating, notes). Only that company and the Vetter
    // team can see or change it; the candidate never sees it
    // Tests still being written: only their company and the Vetter team see them; '' is the Vetter library's
    match /testDrafts/{draftId} {
      allow read: if signedIn() && (isAdmin() || worksAt(resource.data.businessId));
      allow create, update: if (isAdmin() || worksAt(request.resource.data.businessId))
        && request.resource.data.id == draftId
        && (resource == null || resource.data.businessId == request.resource.data.businessId);
      allow delete: if isAdmin() || worksAt(resource.data.businessId);
    }

    // What a candidate answered on a test taken for a company (src/lib/submissions.ts): the candidate, that company and
    // the Vetter team can read it; nobody else, as the answers would give the test away. Written once, by the candidate
    match /submissions/{submissionId} {
      allow read: if signedIn() && (isAdmin() || worksAt(resource.data.businessId) || resource.data.candidateId == uid());
      allow create: if signedIn() && request.resource.data.candidateId == uid()
        && request.resource.data.id == submissionId
        && request.resource.data.businessId is string && request.resource.data.businessId != ''
        && request.resource.data.answers is list;
      allow update, delete: if isAdmin();
    }

    // A company's own tries at tests, seen only by its team and the Vetter team
    match /trials/{trialId} {
      allow read: if signedIn() && (isAdmin() || worksAt(resource.data.businessId));
      allow create: if (isAdmin() || worksAt(request.resource.data.businessId))
        && request.resource.data.id == trialId
        && request.resource.data.takenBy == uid()
        && request.resource.data.keys().hasOnly(['id', 'businessId', 'testId', 'jobId', 'score', 'completedAt',
          'durationSeconds', 'takenBy', 'takenByName']);
      allow delete: if isAdmin() || worksAt(resource.data.businessId);
    }

    match /leads/{leadId} {
      allow read: if signedIn() && (isAdmin() || worksAt(resource.data.businessId));
      allow create, update: if (isAdmin() || worksAt(request.resource.data.businessId))
        && leadId == request.resource.data.jobId + '__' + request.resource.data.candidateId
        && request.resource.data.businessId == jobDoc(request.resource.data.jobId).get('businessId', '')
        && (resource == null || resource.data.businessId == request.resource.data.businessId)
        && request.resource.data.stage in ['invited', 'applied', 'screening', 'interview', 'offer', 'hired', 'archived']
        && request.resource.data.keys().hasOnly(['id', 'jobId', 'candidateId', 'businessId', 'stage', 'rating', 'note',
          'archiveReason', 'dueDate', 'tags', 'updatedAt', 'history']);
      allow delete: if isAdmin() || worksAt(resource.data.businessId);
    }

    // Career switch course sign-ups: anyone can leave their details (signed in or not), only the Vetter team reads
    // them. See src/lib/courseSignups.ts
    match /courseSignups/{signupId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['courseId', 'courseTitle', 'price', 'name', 'email', 'phone', 'note', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['courseId', 'courseTitle', 'price', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.courseId is string && request.resource.data.courseId.size() <= 100
        && request.resource.data.courseTitle is string && request.resource.data.courseTitle.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 25
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 1000
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == uid()))
        && request.resource.data.createdAt == request.time;
    }

    // An application, seen by the candidate and the company they applied to
    match /applications/{applicationId} {
      allow read: if signedIn() && (uid() == resource.data.candidateId || isAdmin() || worksAt(resource.data.businessId));
      allow create: if activeCandidate() && request.resource.data.candidateId == uid()
        && applicationId == request.resource.data.jobId + '__' + uid()
        && request.resource.data.businessId == jobDoc(request.resource.data.jobId).get('businessId', '');
      allow delete: if isAdmin();
    }

    // Tests made in the app: a company's own, or the Vetter team's. Anyone can open a test page
    // A company's test in the public library (publicStatus): the company may ask (pending) or take it back, and only
    // the Vetter team approves or turns it down. Any change a company makes to an approved test takes it out of
    // 'approved', so nothing reaches other companies and candidates without being checked
    function publicAskOnly() {
      let now = request.resource.data.get('publicStatus', null);
      return now == null || now == 'pending'
        || (now == 'rejected' && resource != null && resource.data.get('publicStatus', null) == 'rejected');
    }
    match /tests/{testId} {
      allow read: if true;
      allow create: if isAdmin() || (request.resource.data.type == 'custom' && worksAt(request.resource.data.businessId)
        && request.resource.data.get('publicStatus', null) in [null, 'pending']);
      allow update: if isAdmin()
        || (worksAt(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.type == 'custom' && publicAskOnly());
      allow delete: if isAdmin() || worksAt(resource.data.businessId);
    }

    // The feed: anyone can read it; people write, comment and give kudos as themselves
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && verified() && request.resource.data.authorId == uid();
      allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && verified() && request.resource.data.authorId == uid();
      allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());
    }
    match /kudos/{kudosId} {
      allow read: if true;
      allow create: if signedIn() && verified() && request.resource.data.uid == uid() && kudosId.matches('.*__' + uid());
      allow delete: if signedIn() && resource.data.uid == uid();
    }
    // Who someone follows: theirs alone
    match /follows/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // Telling a candidate they've been sent a job's tests. Companies send them; candidates mark them read
    match /notifications/{noteId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && verified() && (
        isAdmin() || request.resource.data.userId == uid()
        || worksAt(jobDoc(request.resource.data.jobId).get('businessId', ''))
      );
      allow update: if signedIn() && resource.data.userId == uid() && changed().hasOnly(['read']);
    }

    match /companies/{companyId} {
      // Approved companies are public (the Companies page); signed-in people can see the rest, so a sign-up can be
      // told it's joining an existing one
      allow read: if resource.data.status == 'active' || signedIn();

      // The plan is set by the Vetter team only, never by the company that pays for it
      allow create: if signedIn() && verified() && request.resource.data.ownerUid == uid() && !('plan' in request.resource.data) && (
        // A company's id is its email domain, claimed only by a verified address at that domain
        (companyId == emailDomain() && !(emailDomain() in freeDomains())
          && request.resource.data.domain == companyId && request.resource.data.status == 'active')
        // Without a work email, a company waits for review
        || (companyId == 'review-' + uid() && request.resource.data.status == 'pending-review')
      );

      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == uid()
          && changed().hasOnly(['name', 'website', 'logo', 'industry', 'headquarters', 'companySize', 'description', 'techStack']));
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if signedIn() && (uid() == memberId || ownsCompany(companyId) || isAdmin());
        // Asking to join your own domain's company
        allow create: if signedIn() && uid() == memberId && verified() && companyId == emailDomain()
          && request.resource.data.status == 'pending-approval';
        allow update: if signedIn() && (ownsCompany(companyId) || isAdmin())
          && changed().hasOnly(['status']) && request.resource.data.status in ['active', 'rejected'];
      }
    }
  }
}
